{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "Node16",
    "moduleResolution": "Node16",

    "target": "ES2020",
    "lib": ["ES2020"],

    "types": ["node"],

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,

    "sourceMap": true,
    "skipLibCheck": true
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}